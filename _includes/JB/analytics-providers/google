{% assign google_measurement_id = site.JB.analytics.google.measurement_id | default: '' %}
{% if google_measurement_id != '' %}
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ google_measurement_id | uri_escape }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', {{ google_measurement_id | jsonify }});
</script>
{% endif %}
