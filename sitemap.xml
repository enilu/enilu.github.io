---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% assign documents = site.posts | concat: site.english | concat: site.pages %}
{% for document in documents %}
{% assign ending = document.url | slice: -1, 1 %}
{% if document.path contains '.html' or document.path contains '.md' or document.path contains '.markdown' or ending == '/' or document.collection == 'posts' or document.collection == 'english' %}
<url>
  <loc>{{ document.url | absolute_url | xml_escape }}</loc>
  {% if document.translation_key %}
  {% assign versions = documents | where: 'translation_key', document.translation_key %}
  {% for version in versions %}
  <xhtml:link rel="alternate" hreflang="{{ version.lang | default: 'zh-CN' }}" href="{{ version.url | absolute_url | xml_escape }}"/>
  {% endfor %}
  {% endif %}
</url>
{% endif %}
{% endfor %}
</urlset>
